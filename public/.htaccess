# Route ALL requests through PHP to fix MIME type issues
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite index.php itself
  RewriteRule ^index\.php$ - [L]

  # Route everything through index.php (PHP sets correct MIME types)
  RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
